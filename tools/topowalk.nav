# The optimisation walkthrough: a bracket held and loaded, optimised, the surviving part exported as an STL and
# printed in the LPBF build simulation (T21 items 3 and 4).
#   ./openphysics --headless --size 1600x1000 --workspace /tmp/openphysics-topo --exec 'exec tools/topowalk.nav'
workspace solid
frames 4
echo TOPO start
am project_create '{"name": "topo_bracket", "description": "stiffness optimisation of the sample bracket"}'
am geometry_import '{"path": "samples/bracket.stl", "units": "mm", "name": "bracket"}'
am material_assign '{"body": "bracket", "material": "ss316l_lpbf_demo", "source": "user"}'
am mesh_generate '{"element_size": "1 mm"}'
am selection_create '{"name": "foot", "query": {"all": [{"facing": {"direction": "down"}}, {"plane": {"axis": "z", "at": "min"}}]}, "source": "user"}'
am selection_create '{"name": "top", "query": {"extreme": {"direction": "+z"}}, "source": "user"}'
am boundary_apply '{"name": "hold", "kind": "fixed", "selection": "foot", "source": "user"}'
am boundary_apply '{"name": "push", "kind": "force", "selection": "top", "force": ["0.5 kN", 0, 0], "source": "user"}'
solid run static
solid wait 300
frames 20
fem fit
fem edges on
fem shadows on
frames 6
screenshot /tmp/openphysics-topowalk-before.png
# through the panel, with real clicks: open OPTIMISE, then press OPTIMISE NOW
uiclick OPTIMISE
frames 6
screenshot /tmp/openphysics-topowalk-panel.png
uiclick "OPTIMISE NOW"
frames 8
screenshot /tmp/openphysics-topowalk-running.png
fem optimwait 600
frames 12
fem fit
frames 6
screenshot /tmp/openphysics-topowalk-after.png
fem density
uiclick "EXPORT STL"
frames 10
fem optipart /tmp/openphysics-topowalk-optimised.stl
frames 10
fem fit
camera zoom 0.7
frames 6
fem export /tmp/openphysics-topowalk-part.png 2
echo TOPO optimised

# the chain the gallery shows: the optimised part goes straight into the print simulation
am project_create '{"name": "optimised_print", "description": "the optimised bracket, printed"}'
am geometry_import '{"path": "/tmp/openphysics-topowalk-optimised.stl", "units": "mm", "name": "optimised"}'
am material_assign '{"body": "optimised", "material": "alsi10mg_lpbf", "source": "user"}'
am mesh_generate '{"element_size": "0.8 mm"}'
am lpbf_build_run '{"body": "optimised", "build_orientation": "Y", "layer_thickness_sim": "0.8 mm", "inherent_strain": {"exx": -0.001, "eyy": -0.002, "ezz": 0, "provenance": "assumed", "source": "a demonstration strain, the refinement study's tensor (validation/printing-refinement), not a calibration"}, "material": {"youngs_modulus": "71000 MPa", "poissons_ratio": 0.33, "provenance": "user"}, "label": "optimised bracket"}'
solid wait 600
frames 20
fem follow
frames 20
fem fit
camera zoom 0.55
fem step last
fem edges on
frames 8
fem export /tmp/openphysics-topowalk-print.png 2
echo TOPO printed
quit
