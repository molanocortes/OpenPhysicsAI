<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- build/OpenPhysicsAIListen.app: the headset's speech recognition as a background app with its own name, so that macOS
     asks once whether it may recognise speech, whoever started the bridge (tools/xr/listen.swift, docs/xr.md) -->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key><string>lab.openphysicsai.listen</string>
    <key>CFBundleName</key><string>OpenPhysicsAI Listen</string>
    <key>CFBundleDisplayName</key><string>OpenPhysicsAI Listen</string>
    <key>CFBundleExecutable</key><string>listen</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>1.0</string>
    <key>LSMinimumSystemVersion</key><string>11.0</string>
    <key>LSUIElement</key><true/>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>OpenPhysicsAI turns what you say in the headset into words on this Mac, so that the AI can answer you.</string>
</dict>
</plist>
